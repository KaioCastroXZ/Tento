# Copie para `keystore.properties` (que está no .gitignore) e preencha.
# Gere a chave uma vez:
#
#   keytool -genkeypair -v -keystore ~/tento-upload.jks \
#     -alias tento -keyalg RSA -keysize 2048 -validity 10000
#
# Guarde o .jks e as senhas MUITO bem — perdeu = não atualiza mais o app.

storeFile=/home/SEU_USUARIO/tento-upload.jks
storePassword=SUA_SENHA_DO_KEYSTORE
keyAlias=tento
keyPassword=SUA_SENHA_DA_CHAVE
